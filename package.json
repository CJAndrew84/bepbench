{
  "name": "bepbench-netlify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config webapp/vite.config.js --host 0.0.0.0",
    "generate": "node webapp/scripts/generate-data.mjs",
    "build": "npm run generate && vite build --config webapp/vite.config.js",
    "preview": "vite preview --config webapp/vite.config.js --host 0.0.0.0",
    "test": "npm run generate && node --test webapp/tests/*.test.mjs"
  },
  "dependencies": {
    "docx": "^9.14.0",
    "idb-keyval": "^6.3.0",
    "three": "^0.186.1",
    "web-ifc": "^0.0.78",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "vite": "^8.3.5"
  }
}
